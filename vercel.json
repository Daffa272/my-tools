{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "hub": {
      "root": "hub",
      "framework": "vite"
    },
    "kbbi": {
      "root": "kbbi",
      "framework": "vite"
    },
    "listening": {
      "root": "listening",
      "framework": "vite"
    },
    "note": {
      "root": "note",
      "framework": "vite"
    },
    "object": {
      "root": "object",
      "framework": "vite"
    },
    "object-api": {
      "root": "object",
      "framework": "express",
      "entrypoint": "index.js"
    },
    "pauli": {
      "root": "pauli",
      "framework": "vite"
    },
    "vocab": {
      "root": "vocab",
      "framework": "vite"
    }
  },
  "redirects": [
    { "source": "/kbbi", "destination": "/kbbi/", "permanent": true },
    { "source": "/listening", "destination": "/listening/", "permanent": true },
    { "source": "/note", "destination": "/note/", "permanent": true },
    { "source": "/object", "destination": "/object/", "permanent": true },
    { "source": "/pauli", "destination": "/pauli/", "permanent": true },
    { "source": "/vocab", "destination": "/vocab/", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "object-api" }
    },
    {
      "source": "/kbbi/",
      "destination": { "service": "kbbi", "path": "/" }
    },
    {
      "source": "/kbbi/:path*",
      "destination": { "service": "kbbi", "path": "/:path*" }
    },
    {
      "source": "/listening/",
      "destination": { "service": "listening", "path": "/" }
    },
    {
      "source": "/listening/:path*",
      "destination": { "service": "listening", "path": "/:path*" }
    },
    {
      "source": "/note/",
      "destination": { "service": "note", "path": "/" }
    },
    {
      "source": "/note/:path*",
      "destination": { "service": "note", "path": "/:path*" }
    },
    {
      "source": "/object/",
      "destination": { "service": "object", "path": "/" }
    },
    {
      "source": "/object/:path*",
      "destination": { "service": "object", "path": "/:path*" }
    },
    {
      "source": "/pauli/",
      "destination": { "service": "pauli", "path": "/" }
    },
    {
      "source": "/pauli/:path*",
      "destination": { "service": "pauli", "path": "/:path*" }
    },
    {
      "source": "/vocab/",
      "destination": { "service": "vocab", "path": "/" }
    },
    {
      "source": "/vocab/:path*",
      "destination": { "service": "vocab", "path": "/:path*" }
    },
    {
      "source": "/",
      "destination": { "service": "hub" }
    }
  ]
}
